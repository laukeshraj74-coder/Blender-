{
  "name": "ai-video-generator",
  "version": "0.1.0",
  "description": "Professional AI Video Generator Desktop Application",
  "main": "frontend/src/main.js",
  "scripts": {
    "start": "concurrently \"npm run backend\" \"npm run electron\"",
    "backend": "cd backend && python main.py",
    "electron": "electron .",
    "build": "electron-builder",
    "dev": "electron ."
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "concurrently": "^8.2.2"
  },
  "dependencies": {},
  "build": {
    "appId": "com.aivideogenerator.app",
    "productName": "AI Video Generator",
    "directories": {
      "output": "dist"
    },
    "files": [
      "frontend/**/*",
      "backend/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "frontend/assets/icon.ico"
    }
  }
}
